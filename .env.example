# SkinSense Agent environment example - copy to .env or export in your shell.  # Header: what this file is.
# NEVER commit a real key; .env is git-ignored on purpose.  # Warning: keys stay out of git.
# The YouCam API key from the YouCam console (Account > API Key). Without it the app runs in clearly labeled SAMPLE mode.  # Variable: the API key.
YOUCAM_API_KEY=  # Empty means SAMPLE mode.
# Optional: override the API host (default is the documented https://yce-api-01.makeupar.com).  # Variable: API host override.
YOUCAM_API_BASE=https://yce-api-01.makeupar.com  # Documented production host.
# Optional: task-path version (default v2.0 per the official usage guide; some production apps use v2.1 - flip only if a live call 404s).  # Variable: API version override.
YOUCAM_API_VERSION=v2.0  # Documented default.
# Optional: the port the demo server listens on.  # Variable: server port.
PORT=8770  # Default demo port.
